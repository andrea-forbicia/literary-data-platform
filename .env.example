# Copy this file to .env and adjust the values. .env is ignored by git.
# The Makefile loads .env, so `make` targets see these variables.

# Root folder of the local data lake. Raw files go under $DATA_DIR/raw/.
DATA_DIR=data

# Project Gutenberg mirror used for the catalogue and the book texts.
GUTENBERG_MIRROR_URL=https://gutenberg.pglaf.org

# User-Agent sent with every HTTP request, so that sources can tell who is calling.
HTTP_USER_AGENT=literary-data-platform/0.1
